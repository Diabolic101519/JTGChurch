rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'body', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'body', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'caption', 'storagePath', 'downloadUrl', 'contentType', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'caption', 'storagePath', 'downloadUrl', 'contentType', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 500
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('posts/' + request.auth.uid + '/[^/]+')
        && request.resource.data.downloadUrl is string
        && request.resource.data.downloadUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')
        && request.resource.data.contentType is string
        && request.resource.data.contentType.matches('(image|video)/.*')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
